
pipeline {
    agent any

    tools {
        nodejs 'NodeJS'
    }

    environment {
        DOCKERHUB_USER = 'mavrickdocker'
        BACKEND_IMAGE  = 'dubai-properties-backend'
        FRONTEND_IMAGE = 'dubai-properties-frontend'

        GCP_PROJECT   = 'project-a70c7f47-e201-489a-87f'
        GKE_CLUSTER   = 'dubai-properties-gke'
        GKE_ZONE      = 'us-central1-a'
        K8S_NAMESPACE = 'dubai-properties'
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'dev',
                    url: 'https://github.com/sb-sachinborse/3-Tier-webapp-DevSecOps.git'
            }
        }

        stage('Build Application') {
            parallel {
                stage('Build Backend') {
                    steps {
                        dir('backend') {
                            sh 'go mod download'
                            sh 'go build ./...'
                        }
                    }
                }

                stage('Build Frontend') {
                    steps {
                        dir('frontend') {
                            sh 'npm ci'
                            sh 'npm run build'
                        }
                    }
                }
            }
        }

        stage('Unit Testing') {
            steps {
                dir('backend') {
                    sh 'go test ./...'
                }
            }
        }

        stage('Gitleaks - Secret Scan') {
            steps {
                sh '''
                    mkdir -p reports
                    gitleaks detect --source . \
                    --report-format json \
                    --report-path reports/gitleaks-report.json || true
                '''
            }
        }

        stage('SonarQube - SAST') {
            steps {
                script {
                    def scannerHome = tool 'SonarScanner'

                    withSonarQubeEnv('sonar') {
                        sh """
                            ${scannerHome}/bin/sonar-scanner \
                            -Dsonar.projectKey=dubai-properties \
                            -Dsonar.projectName='Dubai Properties' \
                            -Dsonar.sources=backend,frontend \
                            -Dsonar.exclusions=**/node_modules/**,**/dist/**
                        """
                    }
                }
            }
        }

        stage('SonarQube Quality Gate') {
            steps {
                echo 'Quality Gate placeholder - real check not configured yet'
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    docker build \
                    -t $DOCKERHUB_USER/$BACKEND_IMAGE:$BUILD_NUMBER \
                    -t $DOCKERHUB_USER/$BACKEND_IMAGE:latest \
                    -f backend/Dockerfile backend

                    docker build \
                    -t $DOCKERHUB_USER/$FRONTEND_IMAGE:$BUILD_NUMBER \
                    -t $DOCKERHUB_USER/$FRONTEND_IMAGE:latest \
                    -f frontend/Dockerfile frontend
                '''
            }
        }

        stage('Trivy - Image Scan') {
            steps {
                sh '''
                    mkdir -p reports

                    trivy image \
                    --format table \
                    --output reports/backend-image-report.txt \
                    $DOCKERHUB_USER/$BACKEND_IMAGE:$BUILD_NUMBER || true

                    trivy image \
                    --format table \
                    --output reports/frontend-image-report.txt \
                    $DOCKERHUB_USER/$FRONTEND_IMAGE:$BUILD_NUMBER || true
                '''
            }
        }

        stage('Push Docker Images') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'docker-hub',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -e
                        trap 'docker logout >/dev/null 2>&1 || true' EXIT

                        echo "$DOCKER_PASSWORD" | docker login \
                        -u "$DOCKER_USER" --password-stdin

                        docker push $DOCKERHUB_USER/$BACKEND_IMAGE:$BUILD_NUMBER
                        docker push $DOCKERHUB_USER/$BACKEND_IMAGE:latest

                        docker push $DOCKERHUB_USER/$FRONTEND_IMAGE:$BUILD_NUMBER
                        docker push $DOCKERHUB_USER/$FRONTEND_IMAGE:latest
                    '''
                }
            }
        }

        stage('GKE Authentication') {
            steps {
                sh '''
                    set -e

                    echo "Connecting to GKE..."

                    gcloud container clusters get-credentials "$GKE_CLUSTER" \
                        --zone "$GKE_ZONE" \
                        --project "$GCP_PROJECT"

                    echo "Current Kubernetes context:"
                    kubectl config current-context

                    echo "Checking deployment permissions..."

                    kubectl auth can-i patch deployments -n "$K8S_NAMESPACE" \
                        | grep -qx yes

                    kubectl auth can-i get pods -n "$K8S_NAMESPACE" \
                        | grep -qx yes

                    echo "GKE authentication and permission checks passed."
                '''
            }
        }

        stage('Deploy to GKE') {
            steps {
                sh '''
                    set -e

                    echo "Deploying backend image..."

                    kubectl set image deployment/backend \
                        backend="$DOCKERHUB_USER/$BACKEND_IMAGE:$BUILD_NUMBER" \
                        -n "$K8S_NAMESPACE"

                    echo "Deploying frontend image..."

                    kubectl set image deployment/frontend \
                        frontend="$DOCKERHUB_USER/$FRONTEND_IMAGE:$BUILD_NUMBER" \
                        -n "$K8S_NAMESPACE"
                '''
            }
        }

        stage('GKE Rollout Verification') {
            steps {
                sh '''
                    set -e

                    echo "Waiting for backend rollout..."

                    kubectl rollout status deployment/backend \
                        -n "$K8S_NAMESPACE" --timeout=180s

                    echo "Waiting for frontend rollout..."

                    kubectl rollout status deployment/frontend \
                        -n "$K8S_NAMESPACE" --timeout=180s

                    echo "Current application pods:"

                    kubectl get pods -n "$K8S_NAMESPACE" -o wide

                    echo "GKE deployment completed successfully!"
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'reports/**',
                             allowEmptyArchive: true

            echo 'Pipeline execution completed.'
        }

        success {
            echo 'Application images pushed and deployment completed successfully!'
        }

        failure {
            echo 'Pipeline failed. Check Jenkins console output.'
        }
    }
}

